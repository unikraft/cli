$ unikraft service --help

stdout:
	Manage Unikraft Cloud services.

	Usage:
	  unikraft services <command> [flags]

	Commands:
	  get, inspect, show
	          Inspect a service.
	  wait
	          Wait for services to match a filter.
	  list, ls
	          List services.
	  delete, rm, remove
	          Remove a service.
	  edit
	          Edit a service.
	  create
	          Create a service.

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft service get --help

stdout:
	Inspect a service.

	Usage:
	  unikraft services get [<name> ...] [flags]

	Arguments:
	  [<name> ...]
	          Names of the services to inspect.

	Examples:
	  # Inspect a service group by name or UUID
	  unikraft service get demo-service

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Flags:
	  -w, --watch
	          Watch for changes and refresh output.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft service list --help

stdout:
	List services.

	Usage:
	  unikraft services list [<name> ...] [flags]

	Arguments:
	  [<name> ...]
	          Names of the services to list.

	Examples:
	  # List all service groups
	  unikraft service list

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Flags:
	      --filter
	          Filter output based on a field value (e.g. --filter state==running).
	  -w, --watch
	          Watch for changes and refresh output.
	      --sort
	          Sort output by field values (e.g. --sort name,-timestamps.created-at). Use - prefix for descending, + for ascending.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft service wait --help

stdout:
	Wait for services to match a filter.

	Usage:
	  unikraft services wait --until=UNTIL <name> ... [flags]

	Arguments:
	  <name> ...
	          Names of the services to wait for.

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Flags:
	      --until, --filter
	          Filter expression to wait for (e.g. --until state==running).
	      --interval
	          Polling interval.
	          [default: 2s]
	      --timeout
	          Timeout before giving up.
	          [default: 0]
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft service create --help

stdout:
	Create a service.

	Usage:
	  unikraft services create [flags]

	Examples:
	  # Create a new service group
	  unikraft service create \
	    --set name=demo-service \
	    --set metro=fra \
	    --set domains=name=demo \
	    --set services=443:8080/tls+http

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Flags:
	      --set, --set-file
	          Key-value pairs to set on the service.
	  -e, --visual
	          Open an editor to modify fields visually.
	      --cmd
	          Run a command to edit fields (receives YAML on stdin, outputs edited YAML on stdout).
	      --load, --save
	          Load fields from a YAML file.
	      --dry-run
	          Print patches without applying them.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft service edit --help

stdout:
	Edit a service.

	Usage:
	  unikraft services edit [<name>] [flags]

	Arguments:
	  [<name>]
	          Name of the service to edit.

	Examples:
	  # Add a new service port
	  unikraft service edit demo-service --add services=8443:8080/tls

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Flags:
	      --set, --set-file
	          Key-value pairs to set on the service.
	      --add, --add-file
	          Key-value pairs to add to the service.
	      --del, --del-file
	          Keys to delete from the service.
	  -e, --visual
	          Open an editor to modify fields visually.
	      --cmd
	          Run a command to edit fields (receives YAML on stdin, outputs edited YAML on stdout).
	      --load, --save
	          Load fields from a YAML file.
	      --dry-run
	          Print patches without applying them.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft service delete --help

stdout:
	Remove a service.

	Usage:
	  unikraft services delete [<name> ...] [flags]

	Arguments:
	  [<name> ...]
	          Names of the services to remove.

	Examples:
	  # Delete a service group by name or UUID
	  unikraft service delete demo-service

	Fields:
	  metro
	  name
	  uuid
	  persistent
	  autoscale
	  limits, limits.soft, limits.hard
	  timestamps, timestamps.created
	  domains, domains.*, domains.*.fqdn, domains.*.certificate,
	  domains.*.certificate.name, domains.*.certificate.uuid
	  instances, instances.*, instances.*.name, instances.*.uuid
	  services, services.*

	Flags:
	      --all
	          Remove all services. Prompts for confirmation.
	      --filter
	          Filter services to remove (e.g. --filter state==running). Prompts for confirmation.
	      --force
	          Do not prompt for confirmation when using --all or --filter.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.
