$ unikraft volume wait --help

stdout:
	Usage:
	  unikraft volumes wait --until=UNTIL <name> ... [flags]

	Wait for volumes to match a filter.

	Arguments:
	  <name> ...
	          Names of the volumes to wait for.

	Fields:
	  metro
	  name
	  uuid
	  tags
	  state
	  size
	  persistent
	  timestamps, timestamps.created-at
	  attached-to, attached-to.*, attached-to.*.name, attached-to.*.uuid
	  mounted-by, mounted-by.*, mounted-by.*.name, mounted-by.*.uuid, mounted-
	  by.*.read-only

	Flags:
	      --until, --filter
	          Filter expression to wait for (e.g. --until state==running).
	      --interval
	          Polling interval.
	          [default: 2s]
	      --timeout
	          Timeout before giving up.
	          [default: 0]
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft volume create --help

stdout:
	Usage:
	  unikraft volumes create [flags]

	Create a volume.

	Examples:
	  # Create a new volume
	  unikraft volume create \
	    --set name=demo-volume \
	    --set size=10 \
	    --set metro=fra

	Fields:
	  metro
	  name
	  uuid
	  tags
	  state
	  size
	  persistent
	  timestamps, timestamps.created-at
	  attached-to, attached-to.*, attached-to.*.name, attached-to.*.uuid
	  mounted-by, mounted-by.*, mounted-by.*.name, mounted-by.*.uuid, mounted-
	  by.*.read-only

	Flags:
	      --set
	          Key-value pairs to set on the volume.
	      --set-file
	          Files containing key-value pairs to set on the volume.
	  -e, --visual
	          Open an editor to set fields visually.
	      --dry-run
	          Print patches without applying them.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft volume clone --help

stdout:
	Usage:
	  unikraft volumes clone <source> [flags]

	Clone a volume.

	Arguments:
	  <source>
	          Name or UUID of the volume to clone.

	Examples:
	  # Clone a volume with a new name
	  unikraft volume clone demo-volume --set name=demo-volume-clone

	Flags:
	      --set
	          Key-value pairs to set on the volume.
	      --set-file
	          Files containing key-value pairs to set on the volume.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

$ unikraft volume edit --help

stdout:
	Usage:
	  unikraft volumes edit <name> [flags]

	Edit a volume.

	Arguments:
	  <name>
	          Name of the volume to edit.

	Examples:
	  # Resize a volume
	  unikraft volume edit demo-volume --set size=20

	Fields:
	  metro
	  name
	  uuid
	  tags
	  state
	  size
	  persistent
	  timestamps, timestamps.created-at
	  attached-to, attached-to.*, attached-to.*.name, attached-to.*.uuid
	  mounted-by, mounted-by.*, mounted-by.*.name, mounted-by.*.uuid, mounted-
	  by.*.read-only

	Flags:
	      --set
	          Key-value pairs to set on the volume.
	      --set-file
	          Files containing key-value pairs to set on the volume.
	      --add
	          Key-value pairs to add to the volume.
	      --add-file
	          Files containing key-value pairs to add to the volume.
	      --del
	          Keys to delete from the volume.
	      --del-file
	          Files containing keys to delete from the volume.
	  -e, --visual
	          Open an editor to modify fields visually.
	      --dry-run
	          Print patches without applying them.
	  -f, --field
	          Specify which fields to include in the output.
	  -o, --output
	          Output format. One of: kv, table, json, yaml, raw, quiet, template.

	Global flags:
	  -h, --help
	          Show context-sensitive help.
	      --config ($UNIKRAFT_CONFIG)
	          Path to the configuration file.
	      --log-level ($UNIKRAFT_LOG_LEVEL)
	          Set the logging level.
	          [default: info, choice: trace,debug,info,warn,error,fatal]
	      --log-type ($UNIKRAFT_LOG_TYPE)
	          Set the log type.
	          [default: text, choice: text,json]
	      --profile ($UNIKRAFT_PROFILE)
	          Set the current profile.
	      --[no-]telemetry ($UNIKRAFT_TELEMETRY)
	          Toggle anonymous usage analytics.
	          [default: true]
	      --version
	          Print version information.

